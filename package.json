{
  "name": "@sandritsch91/yad",
  "version": "1.0.0",
  "description": "Yet Another Datepicker — a dependency-free datepicker with a jQuery UI compatible API",
  "type": "module",
  "license": "MIT",
  "author": "Sandritsch91",
  "homepage": "https://github.com/Sandritsch91/yad#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sandritsch91/yad.git"
  },
  "bugs": {
    "url": "https://github.com/Sandritsch91/yad/issues"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/yad.cjs",
  "module": "./dist/yad.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/yad.umd.js",
  "jsdelivr": "./dist/yad.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/yad.js",
      "require": "./dist/yad.cjs"
    },
    "./yad.css": "./dist/yad.css",
    "./themes/*": "./dist/themes/*"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/themes','dist/themes',{recursive:true})\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "datepicker",
    "date",
    "calendar",
    "jquery-ui",
    "vanilla"
  ],
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
